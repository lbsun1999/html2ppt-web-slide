{
  "name": "html2ppt-web-slide",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "本地科研幻灯片模块编辑器，HTML / PDF / 可编辑 PPTX",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "start": "node scripts/start.mjs --open",
    "build:styles": "node scripts/build-style-gallery.mjs",
    "test": "node --test tests/layout.test.mjs tests/advanced-alignment.test.mjs tests/outline.test.mjs tests/table-text.test.mjs tests/startup.test.mjs tests/html-drop.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:styles": "node tests/text-styles.mjs",
    "build:examples": "node scripts/prepare-example.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "clean": "node scripts/clean.mjs",
    "preview:docs": "node scripts/preview-workbench.mjs",
    "build:lishui": "node scripts/prepare-example.mjs --lishui-only",
    "test:all": "node scripts/self-check.mjs"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "katex": "0.16.22",
    "playwright": "1.58.2",
    "pptxgenjs": "4.0.1"
  }
}
