* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
# Generated HTML snapshots have recorded hashes; preserve their exact bytes.
*.html -text whitespace=cr-at-eol
*.css text eol=lf
*.py text eol=lf
# Preserve CRLF in repository blobs as well as ZIP archives (not just checkouts).
*.cmd -text whitespace=cr-at-eol
*.png binary
*.jpg binary
*.svg text eol=lf
*.pdf binary
*.pptx binary
*.mp4 binary
*.zip binary
